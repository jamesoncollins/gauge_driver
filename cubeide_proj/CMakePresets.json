{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base ARM toolchain",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain-arm-gcc.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "base-x86",
      "displayName": "Base x86 MinGW build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CUSTOM_PLATFORM": "x86",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe"
      }
    },
    {
      "name": "base-web",
      "displayName": "Base Emscripten web build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain-emcc.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "st7789vi-debug",
      "displayName": "Debug - ST7789VI",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TARGET": "3000gt_lcd"
      }
    },
    {
      "name": "s6e63d6-debug",
      "displayName": "Debug - S6E63D6",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TARGET": "3000gt_oled"
      }
    },
    {
      "name": "x86-debug",
      "displayName": "Debug - x86",
      "inherits": "base-x86",
      "cacheVariables": {
        "BUILD_TARGET": "sim_3000gt_soft"
      }
    },
    {
      "name": "web-debug",
      "displayName": "Debug - Web",
      "inherits": "base-web",
      "cacheVariables": {
        "BUILD_TARGET": "web_3000gt_soft"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "st7789vi-debug",
      "configurePreset": "st7789vi-debug"
    },
    {
      "name": "s6e63d6-debug",
      "configurePreset": "s6e63d6-debug"
    },
    {
      "name": "x86-debug",
      "configurePreset": "x86-debug",
      "jobs": 8
    },
    {
      "name": "web-debug",
      "configurePreset": "web-debug",
      "jobs": 8
    }
  ]
}
