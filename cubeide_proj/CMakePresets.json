{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base ARM toolchain",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain-arm-gcc.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "base-ucrt64",
      "displayName": "Base x86 MSYS2 UCRT64 build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CUSTOM_PLATFORM": "x86",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
      }
    },
    {
      "name": "base-web",
      "displayName": "Base Emscripten web build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain-emcc.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "st7789vi-debug",
      "displayName": "Debug - ST7789VI",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TARGET": "3000gt_lcd"
      }
    },
    {
      "name": "s6e63d6-debug",
      "displayName": "Debug - S6E63D6",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TARGET": "3000gt_oled"
      }
    },
    {
      "name": "st7789vi-release",
      "displayName": "Release - ST7789VI",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TARGET": "3000gt_lcd"
      }
    },
    {
      "name": "s6e63d6-release",
      "displayName": "Release - S6E63D6",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TARGET": "3000gt_oled"
      }
    },
    {
      "name": "st7789vi-o1-diag",
      "displayName": "O1 Diagnostic - ST7789VI",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TARGET": "3000gt_lcd",
        "GAUGE_OPT_LEVEL": "O1"
      }
    },
    {
      "name": "s6e63d6-o1-diag",
      "displayName": "O1 Diagnostic - S6E63D6",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TARGET": "3000gt_oled",
        "GAUGE_OPT_LEVEL": "O1"
      }
    },
    {
      "name": "x86-debug",
      "displayName": "Debug - x86 UCRT64",
      "inherits": "base-ucrt64",
      "cacheVariables": {
        "BUILD_TARGET": "sim_3000gt_soft"
      }
    },
    {
      "name": "web-debug",
      "displayName": "Debug - Web",
      "inherits": "base-web",
      "cacheVariables": {
        "BUILD_TARGET": "web_3000gt_soft"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "st7789vi-debug",
      "configurePreset": "st7789vi-debug"
    },
    {
      "name": "s6e63d6-debug",
      "configurePreset": "s6e63d6-debug"
    },
    {
      "name": "st7789vi-release",
      "configurePreset": "st7789vi-release"
    },
    {
      "name": "s6e63d6-release",
      "configurePreset": "s6e63d6-release"
    },
    {
      "name": "st7789vi-o1-diag",
      "configurePreset": "st7789vi-o1-diag"
    },
    {
      "name": "s6e63d6-o1-diag",
      "configurePreset": "s6e63d6-o1-diag"
    },
    {
      "name": "x86-debug",
      "configurePreset": "x86-debug",
      "jobs": 8
    },
    {
      "name": "web-debug",
      "configurePreset": "web-debug",
      "jobs": 8
    }
  ]
}
